<Window x:Class="Recodec.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recodec" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="/Recodec.ico" Topmost="True">
    <StackPanel Margin="20,16,20,18">
        <TextBlock Text="La cola ha terminado" FontSize="18" FontWeight="SemiBold" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,8,0,12" FontSize="14" />
        <ProgressBar x:Name="Bar" Maximum="60" Height="6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="NowButton" MinWidth="120" Click="Now_Click" />
            <Button Content="Cancelar" IsCancel="True" IsDefault="True" MinWidth="100" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
