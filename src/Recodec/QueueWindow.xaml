<Window x:Class="Recodec.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cola de conversión — Recodec" Width="760" Height="560" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" Icon="/Recodec.ico">
    <DockPanel Margin="16,12,16,16">
        <!-- Barra de acciones -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource HelpButton}" CommandParameter="cola" />
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding StartQueueCommand}" Style="{DynamicResource AccentButtonStyle}"
                        Visibility="{Binding IsIdle, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Iniciar cola" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CancelCommand}" Visibility="{Binding IsRunning, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE711;" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Cancelar" />
                    </StackPanel>
                </Button>
                <Button Content="Quitar terminados" Command="{Binding ClearFinishedCommand}" Margin="8,0,0,0" />
                <TextBlock Text="Al terminar" VerticalAlignment="Center" Margin="20,0,6,0" />
                <ComboBox ItemsSource="{Binding WhenDoneOptions}" SelectedItem="{Binding SelectedWhenDone}" Width="190"
                          ToolTip="Qué hace el equipo cuando termina toda la cola. Antes de suspender o apagar hay una cuenta atrás de 60 s para cancelarlo." />
            </StackPanel>
        </DockPanel>

        <!-- Progreso general -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ProgressBar Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="6" Margin="0,6,0,0" />
        </StackPanel>

        <Border CornerRadius="8" BorderThickness="1" Padding="12"
                BorderBrush="{DynamicResource TabViewSelectedItemBorderBrush}" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding QueueIsEmpty, Converter={StaticResource Vis}}" MaxWidth="440">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8FD;" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="La cola está vacía" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,6,0,0" FontSize="13"
                               Text="Abre un vídeo, ajústalo y pulsa &quot;Añadir a la cola&quot;. También puedes arrastrar varios vídeos o una carpeta a la ventana principal." />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Queue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                            <Button Command="{Binding OpenFolderCommand}" ToolTip="Abrir la carpeta" Padding="8,2" MinWidth="0">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" />
                                            </Button>
                                            <Button Command="{Binding RemoveCommand}" ToolTip="Quitar de la cola" Padding="8,2" MinWidth="0" Margin="4,0,0,0">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding StateLabel}" FontSize="12" />
                                                </Border>
                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding OutputPath, StringFormat=Destino: {0}}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <ProgressBar Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="4" Margin="0,8,0,4" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
