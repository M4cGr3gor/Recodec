<Window x:Class="Recodec.DevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teles en la red — Recodec" Width="980" Height="760" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" Icon="/Recodec.ico" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Fila "formato: sí / no" con su icono de color -->
        <DataTemplate x:Key="SupportRowTemplate">
            <DockPanel Margin="0,3">
                <TextBlock x:Name="Ico" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding Icon}" FontSize="13" Width="22"
                           VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <StackPanel>
                    <TextBlock x:Name="Name" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding Text, Converter={StaticResource Vis}}" Margin="0,1,0,2" />
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOk}" Value="True">
                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="20,14,20,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Teles y reproductores en la red" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource HelpButton}" CommandParameter="tele-dlna" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,12"
                       Text="Recodec pregunta a cada tele qué formatos acepta, igual que hace Windows antes de &quot;Reproducir en&quot;. Así sabe qué contenedor, vídeo y audio usar para que la tele no diga que no puede reproducir el archivo." />
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding ScanCommand}" Style="{DynamicResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Buscar en la red" />
                    </StackPanel>
                </Button>
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="100" Margin="12,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsScanning, Converter={StaticResource Vis}}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="{Binding LogText}" />
            </DockPanel>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Content="Cerrar" IsCancel="True" HorizontalAlignment="Right" MinWidth="100" Margin="0,12,0,0" />

        <Border CornerRadius="8" BorderThickness="1" Padding="14,12"
                BorderBrush="{DynamicResource TabViewSelectedItemBorderBrush}" Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}">
            <Grid>
                <TextBlock Text="Todavía no hay ninguna tele. Pulsa &quot;Buscar en la red&quot; con la tele encendida." Style="{StaticResource Muted}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasDevices, Converter={StaticResource NotVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="18,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Border Style="{StaticResource Chip}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="{Binding IsTarget, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="Es tu tele elegida" FontSize="12" />
                                                </Border>
                                                <Button Content="Elegir esta tele" Command="{Binding UseCommand}" Style="{DynamicResource AccentButtonStyle}"
                                                        Visibility="{Binding IsNotTarget, Converter={StaticResource Vis}}" />
                                                <Button Command="{Binding ForgetCommand}" ToolTip="Olvidar esta tele" Padding="8,2" MinWidth="0" Margin="6,0,0,0">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="Contenedor" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Containers}" ItemTemplate="{StaticResource SupportRowTemplate}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                <TextBlock Text="Vídeo" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding VideoCodecs}" ItemTemplate="{StaticResource SupportRowTemplate}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Audio" FontWeight="SemiBold" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding AudioCodecs}" ItemTemplate="{StaticResource SupportRowTemplate}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE82F;" VerticalAlignment="Top" Margin="0,2,10,0" />
                                                <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </DockPanel>
</Window>
