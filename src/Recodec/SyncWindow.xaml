<Window x:Class="Recodec.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Comprobar la sincronización — Recodec" Width="920" Height="780" MinWidth="700" MinHeight="600"
        WindowStartupLocation="CenterOwner" Icon="/Recodec.ico" ShowInTaskbar="False">
    <DockPanel Margin="20,14,20,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Comprobar la sincronización del audio" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Style="{StaticResource HelpButton}" CommandParameter="sincronizacion" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0">
                <Run Text="Se reproducen" /> <Run Text="20 segundos" FontWeight="SemiBold" /> <Run Text="de la película con la pista" />
                <Run Text="{Binding TrackName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Elige un momento en el que alguien hable de cerca y mira si los labios coinciden con la voz. Si la voz llega tarde, resta milisegundos; si llega antes de que muevan los labios, súmalos." />
            </TextBlock>
        </StackPanel>

        <!-- Botones finales -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancelar" IsCancel="True" MinWidth="100" />
                <Button Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" />
                        <TextBlock Style="{StaticResource ButtonLabel}" Text="Usar este retraso" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding DelayText}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
        </DockPanel>

        <!-- Ajustes -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Momento" Style="{StaticResource Label}" Margin="0,0,16,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Moments}" SelectedItem="{Binding SelectedMoment}" Width="300" HorizontalAlignment="Left" Margin="0,0,0,10" />

                <TextBlock Grid.Row="1" Text="Retraso del audio" Style="{StaticResource Label}" Margin="0,0,16,0" />
                <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="−500" Command="{Binding NudgeCommand}" CommandParameter="-500" MinWidth="58" Margin="0,0,4,0" ToolTip="El audio suena medio segundo antes" />
                    <Button Content="−100" Command="{Binding NudgeCommand}" CommandParameter="-100" MinWidth="58" Margin="0,0,4,0" />
                    <Button Content="−20" Command="{Binding NudgeCommand}" CommandParameter="-20" MinWidth="58" Margin="0,0,8,0" />
                    <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=LostFocus}" Width="90" TextAlignment="Right" VerticalAlignment="Center" x:Name="DelayBox"
                             ToolTip="Milisegundos. Positivo: el audio suena más tarde. Negativo: antes. Pulsa Intro para probarlo." />
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,8,0" />
                    <Button Content="+20" Command="{Binding NudgeCommand}" CommandParameter="20" MinWidth="58" Margin="0,0,4,0" />
                    <Button Content="+100" Command="{Binding NudgeCommand}" CommandParameter="100" MinWidth="58" Margin="0,0,4,0" />
                    <Button Content="+500" Command="{Binding NudgeCommand}" CommandParameter="500" MinWidth="58" Margin="0,0,12,0" ToolTip="El audio suena medio segundo más tarde" />
                    <Button Command="{Binding GenerateCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                            <TextBlock Style="{StaticResource ButtonLabel}" Text="Probar este retraso" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Controles del reproductor -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" x:Name="PlayButton" Click="PlayPause_Click" Padding="10,4" MinWidth="0" ToolTip="Reproducir / pausa">
                <TextBlock x:Name="PlayIcon" FontFamily="{StaticResource IconFont}" Text="&#xE769;" />
            </Button>
            <Button DockPanel.Dock="Left" Click="Restart_Click" Padding="10,4" MinWidth="0" Margin="6,0,0,0" ToolTip="Volver al principio del clip">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" />
            </Button>
            <TextBlock DockPanel.Dock="Right" x:Name="TimeText" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="13" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        </DockPanel>

        <!-- Vídeo -->
        <Border CornerRadius="8" Background="Black" ClipToBounds="True">
            <Grid>
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform"
                              MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed" MediaOpened="Player_MediaOpened" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="320" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                    <TextBlock Text="Preparando el clip…" Foreground="White" HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,8" />
                    <ProgressBar Maximum="100" Value="{Binding Progress, Mode=OneWay}" Height="6" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
