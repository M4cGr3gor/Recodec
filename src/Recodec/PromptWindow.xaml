<Window x:Class="Recodec.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Icon="/Recodec.ico" ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,18">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="Input" MaxLength="60" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="100" />
            <Button x:Name="OkButton" Content="Guardar" IsDefault="True" MinWidth="100" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
